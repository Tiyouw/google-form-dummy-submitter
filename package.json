  "license": "MIT",
  "homepage": "https://github.com/Tiyouw/google-form-dummy-submitter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiyouw/google-form-dummy-submitter.git"
  },
  "bugs": {
    "url": "https://github.com/Tiyouw/google-form-dummy-submitter/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ]
}
