{
  "name": "gformdummy",
  "version": "1.6.0",
  "description": "Submit dummy CSV responses to owned public Google Forms for QA/testing.",
  "type": "module",
  "bin": {
    "gformdummy": "./bin/gformdummy.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --test && node --check bin/gformdummy.js && node --check src/core.js"
  },
  "keywords": [
    "google-forms",
    "forms",
    "csv",
    "dummy-data",
    "testing",
    "qa",
    "automation"
  ],
  "author": "Ahimsa Jenar Bramsaifstyo Kusuma <tio.rmx@gmail.com> (https://github.com/Tiyouw)",
  "license": "MIT",
  "homepage": "https://github.com/Tiyouw/google-form-dummy-submitter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiyouw/google-form-dummy-submitter.git"
  },
  "bugs": {
    "url": "https://github.com/Tiyouw/google-form-dummy-submitter/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "gradient-string": "^3.0.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^14.0.2",
    "oh-my-logo": "^0.5.0"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
